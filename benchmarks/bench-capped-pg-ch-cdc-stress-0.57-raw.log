    checkpoint_timeout = 300s
    full_page_writes = on
    logical_decoding_work_mem = 262144kB
    max_connections = 200
    max_replication_slots = 10
    max_slot_wal_keep_size = 12288MB
    max_wal_senders = 10
    max_wal_size = 2048MB
    min_wal_size = 512MB
